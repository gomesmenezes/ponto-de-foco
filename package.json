{
  "name": "ponto-de-foco",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @ponto-de-foco/web",
    "dev:api": "npm run dev --workspace @ponto-de-foco/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "tsx --test apps/web/src/domain/*.test.ts apps/api/src/*.test.ts",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
